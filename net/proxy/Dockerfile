# Egress allowlist proxy (SPEC NET-1/NET-2). One per project, started by `vibe up`.
# The allowlist is generated by `vibe` and bind-mounted read-only at /etc/vibe/allow.regex.
FROM alpine:3.22
RUN apk add --no-cache tinyproxy
COPY tinyproxy.conf /etc/vibe/tinyproxy.conf
USER 65534:65534
EXPOSE 8888
CMD ["tinyproxy", "-d", "-c", "/etc/vibe/tinyproxy.conf"]
