// opencode (V2) config for the bubble's local-model-only agent.
// Seeded once into ~/.vibe/state/opencode/config/opencode.jsonc — that copy is yours to edit.
//  - The provider MUST stay named "local": the image's managed config (/etc/opencode/opencode.json)
//    enables only that provider.
//  - Its host:port must also be listed in ~/.vibe/local-endpoints.txt, or the proxy refuses it.
{
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "local": {
      "name": "Local model server",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://host.docker.internal:11434/v1",
        "apiKey": "not-needed"   // put your server's key here if it needs one
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B",
          "limit": { "context": 131072, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        }
      }
    }
  },
  "model": "local/qwen3-coder:30b",

  "compaction": {
    // Compact early enough that every request keeps its full output budget.
    "buffer": 32768
  },

  // Ordered; the last matching rule wins.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },

    // read: everything except secrets
    { "action": "read", "resource": "*",            "effect": "allow" },
    { "action": "read", "resource": "*.env",        "effect": "deny" },
    { "action": "read", "resource": "*.env.*",      "effect": "deny" },
    { "action": "read", "resource": "*.key",        "effect": "deny" },
    { "action": "read", "resource": "*.pem",        "effect": "deny" },
    { "action": "read", "resource": "*.p12",        "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*",     "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": ".aws/*",       "effect": "deny" },
    { "action": "read", "resource": "*/.aws/*",     "effect": "deny" },
    { "action": "read", "resource": ".ssh/*",       "effect": "deny" },
    { "action": "read", "resource": "*/.ssh/*",     "effect": "deny" },
    { "action": "read", "resource": ".gnupg/*",     "effect": "deny" },
    { "action": "read", "resource": "*/.gnupg/*",   "effect": "deny" },
    { "action": "read", "resource": "secrets/*",    "effect": "deny" },
    { "action": "read", "resource": "*/secrets/*",  "effect": "deny" },

    // edit (also covers write and patch)
    { "action": "edit", "resource": "*",                     "effect": "allow" },
    { "action": "edit", "resource": "*.env",                 "effect": "deny" },
    { "action": "edit", "resource": "*.env.*",               "effect": "deny" },
    { "action": "edit", "resource": ".ssh/*",                "effect": "deny" },
    { "action": "edit", "resource": "*/.ssh/*",              "effect": "deny" },
    { "action": "edit", "resource": ".git/config",           "effect": "deny" },
    { "action": "edit", "resource": "*/.git/config",         "effect": "deny" },
    { "action": "edit", "resource": ".github/workflows/*",   "effect": "ask" },
    { "action": "edit", "resource": "*/.github/workflows/*", "effect": "ask" },

    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    // shell: each command in a chain, pipe or $(...) is checked on its own;
    // any deny blocks the whole line, any ask prompts
    { "action": "shell", "resource": "*",                      "effect": "ask" },

    // read-only / informational
    { "action": "shell", "resource": "ls *",                   "effect": "allow" },
    { "action": "shell", "resource": "find *",                 "effect": "allow" },
    { "action": "shell", "resource": "tree *",                 "effect": "allow" },
    { "action": "shell", "resource": "file *",                 "effect": "allow" },
    { "action": "shell", "resource": "wc *",                   "effect": "allow" },
    { "action": "shell", "resource": "which *",                "effect": "allow" },
    { "action": "shell", "resource": "echo *",                 "effect": "allow" },
    { "action": "shell", "resource": "pwd *",                  "effect": "allow" },
    { "action": "shell", "resource": "realpath *",             "effect": "allow" },
    { "action": "shell", "resource": "basename *",             "effect": "allow" },
    { "action": "shell", "resource": "dirname *",              "effect": "allow" },
    { "action": "shell", "resource": "stat *",                 "effect": "allow" },
    { "action": "shell", "resource": "du *",                   "effect": "allow" },
    { "action": "shell", "resource": "df *",                   "effect": "allow" },
    { "action": "shell", "resource": "uname *",                "effect": "allow" },
    { "action": "shell", "resource": "nproc *",                "effect": "allow" },
    { "action": "shell", "resource": "date *",                 "effect": "allow" },
    { "action": "shell", "resource": "command -v *",           "effect": "allow" },

    // git: read-only commands, plus local commits (commits are the human's undo button;
    // pushing is impossible from the bubble anyway)
    { "action": "shell", "resource": "git status*",            "effect": "allow" },
    { "action": "shell", "resource": "git diff*",              "effect": "allow" },
    { "action": "shell", "resource": "git log*",               "effect": "allow" },
    { "action": "shell", "resource": "git show*",              "effect": "allow" },
    { "action": "shell", "resource": "git branch*",            "effect": "allow" },
    { "action": "shell", "resource": "git blame*",             "effect": "allow" },
    { "action": "shell", "resource": "git stash list*",        "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse*",         "effect": "allow" },
    { "action": "shell", "resource": "git ls-files*",          "effect": "allow" },
    { "action": "shell", "resource": "git add*",               "effect": "allow" },
    { "action": "shell", "resource": "git commit*",            "effect": "allow" },
    { "action": "shell", "resource": "git -C * status*",       "effect": "allow" },
    { "action": "shell", "resource": "git -C * diff*",         "effect": "allow" },
    { "action": "shell", "resource": "git -C * log*",          "effect": "allow" },
    { "action": "shell", "resource": "git -C * show*",         "effect": "allow" },
    { "action": "shell", "resource": "git -C * branch*",       "effect": "allow" },
    { "action": "shell", "resource": "git -C * blame*",        "effect": "allow" },
    { "action": "shell", "resource": "git -C * stash list*",   "effect": "allow" },
    { "action": "shell", "resource": "git -C * rev-parse*",    "effect": "allow" },
    { "action": "shell", "resource": "git -C * ls-files*",     "effect": "allow" },

    // build
    { "action": "shell", "resource": "cmake *",                "effect": "allow" },
    { "action": "shell", "resource": "ninja*",                 "effect": "allow" },
    { "action": "shell", "resource": "ctest*",                 "effect": "allow" },
    { "action": "shell", "resource": "cargo build*",           "effect": "allow" },
    { "action": "shell", "resource": "cargo test*",            "effect": "allow" },
    { "action": "shell", "resource": "cargo clippy*",          "effect": "allow" },

    // side effects inside otherwise-allowed commands
    { "action": "shell", "resource": "find *-exec*",           "effect": "ask" },
    { "action": "shell", "resource": "find *-delete*",         "effect": "ask" },
    // writes via redirect (best effort: only standalone commands keep their redirect)
    { "action": "shell", "resource": "* > *",                  "effect": "ask" },
    { "action": "shell", "resource": "* >> *",                 "effect": "ask" },

    // destructive / network
    { "action": "shell", "resource": "git push*",              "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*",      "effect": "deny" },
    { "action": "shell", "resource": "git clean*",             "effect": "deny" },
    { "action": "shell", "resource": "git -C * push*",         "effect": "deny" },
    { "action": "shell", "resource": "git -C * reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * clean*",        "effect": "deny" },
    { "action": "shell", "resource": "rm *",                   "effect": "ask" },
    { "action": "shell", "resource": "sudo*",                  "effect": "deny" },
    { "action": "shell", "resource": "curl*",                  "effect": "deny" },
    { "action": "shell", "resource": "wget*",                  "effect": "deny" },
    { "action": "shell", "resource": "ssh*",                   "effect": "deny" },
    { "action": "shell", "resource": "scp*",                   "effect": "deny" },
    { "action": "shell", "resource": "rsync*",                 "effect": "ask" },

    { "action": "webfetch",           "resource": "*", "effect": "deny" },
    { "action": "websearch",          "resource": "*", "effect": "deny" },
    { "action": "subagent",           "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ]
}
